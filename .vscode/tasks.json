{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "NME Windows",
			"type": "shell",
			"command": "nme",
			"args": [
                "build",
				"project.nmml",
				"windows",
				"-debug"
			],
			"group": "build",
			
		},
		{
			"label": "OpenFL Windows",
			"type": "shell",
			"command": "openfl",
			"args": [
                "build",
				"openfl.xml",
				"windows",
				"-debug"
			],
			"group": "build",

		},
		{
			"label": "webview.hdll",
			"type": "shell",
			"command": "native\\build.bat",
		},
		{
			"label": "Heaps HL",
			"type": "shell",
			"command": "haxe",
			"args": [
				"heaps-hl.hxml"
			],
			"dependsOn": "webview.hdll",
			"group": "build",
		}

	]
}